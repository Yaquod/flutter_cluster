# Zenoh runtime configuration for flutter_cluster
# Copy this file to .env and adjust values for your environment.
# .env is gitignored; .env.example is committed.

# Zenoh locator (UDP endpoint to connect to).
# Client mode (default): connect to a specific Autoware endpoint
#   ZENOH_LOCATOR=udp/192.168.1.100:7447
# Peer-to-peer mode (set empty or comment out):
#   ZENOH_LOCATOR=
ZENOH_LOCATOR=udp/127.0.0.1:7447

# Zenoh key expression to subscribe to
ZENOH_KEY_EXPR=autoware/cluster

# Path to the cluster_bridge shared library.
# Default (Linux): libcluster_bridge.so (found in standard lib paths or bundle)
# For custom deployment paths, set the full path here.
# ZENOH_LIBRARY_PATH=/opt/cluster/lib/libcluster_bridge.so
